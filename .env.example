# ===================================================================
# Siyantek Web App — Commercial Production Environment Configuration
# ===================================================================
# Ce fichier sert de modèle pour configurer votre environnement de production.
# Ne committez JAMAIS de clés secrètes réelles dans votre dépôt de code source.

# 1. Configuration du Serveur HTTP & Express
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 2. Sécurité & Sessions (OBLIGATOIRE EN PRODUCTION - Min. 32 caractères aléatoires)
# Générez une clé robuste avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacez_par_une_cle_secrete_aleatoire_de_32_caracteres_min
JWT_SECRET=remplacez_par_une_cle_secrete_aleatoire_de_32_caracteres_min

# 3. Restriction CORS (Domaines autorisés séparés par une virgule)
# Exemple : https://siyantek.tn,https://app.siyantek.tn
ALLOWED_ORIGINS=https://ais-pre-w25uzs35q4uacnoeu72tdl-286763030317.europe-west3.run.app

# 4. Base de Données & Stockage Persistant
# Répertoire local de persistance des données, preuves de virement et sauvegardes automatiques
SIYANTEK_DATA_DIR=./data
SIYANTEK_DB_PATH=./data/siyantek-db.json

# Configuration PostgreSQL managée (Google Cloud SQL, Supabase, Neon) :
# Option 1: URL de connexion standard
DATABASE_URL=postgresql://user:password@host:5432/siyantek_db?sslmode=require
# Option 2: Variables individuelles Cloud SQL Proxy
# SQL_HOST=/cloudsql/project:region:instance
# SQL_DB_NAME=siyantek_db
# SQL_USER=siyantek_app
# SQL_PASSWORD=votre_mot_de_passe_sql

# 5. Initial administrator bootstrap (one-time, minimum 32 random characters)
# Create a normal account, then call POST /api/admin/bootstrap with this header.
# Remove this variable after the first successful bootstrap.
ADMIN_BOOTSTRAP_TOKEN=replace_with_a_random_secret_of_at_least_32_characters

# 6. Coordonnées de support — remplacez par des coordonnées réelles avant publication
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=

# 9. URL Publique Officielle pour Facebook & Réseaux Sociaux (Open Graph)
PUBLIC_APP_URL=https://ais-pre-w25uzs35q4uacnoeu72tdl-286763030317.europe-west3.run.app

# 10. URL du serveur API pour les builds Android natifs (HTTPS obligatoire en production)
# Exemple : VITE_API_BASE_URL=https://api.votre-domaine.tn
# Laisser vide pour le déploiement web sur le même domaine.
VITE_API_BASE_URL=
